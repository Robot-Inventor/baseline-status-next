{
  "name": "@robot-inventor/baseline-status-next",
  "version": "0.1.9",
  "description": "A React component widget displaying Baseline status of a web feature in Next.js",
  "keywords": [
    "react",
    "next",
    "baseline"
  ],
  "homepage": "https://github.com/Robot-Inventor/baseline-status-next#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/baseline-status-next/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/baseline-status-next.git"
  },
  "license": "Apache-2.0",
  "author": "Robot-Inventor",
  "type": "module",
  "main": "dist/BaselineStatus.js",
  "types": "./dist/BaselineStatus.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "eslint --flag unstable_native_nodejs_ts_config \"./src/**/*.{ts,tsx}\"",
    "build": "tsc && shx cp \"./src/**/*.module.css\" \"./dist\"",
    "format": "prettier --write \"./src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"./src/**/*.{ts,tsx,css}\"",
    "ci:version": "changeset version",
    "ci:publish": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@robot-inventor/eslint-config": "^13.0.2",
    "@robot-inventor/tsconfig-base": "^7.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.1",
    "next": "^16.3.0",
    "prettier": "^3.9.6",
    "shx": "^0.4.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "zod-validation-error": "^5.0.0"
  }
}
