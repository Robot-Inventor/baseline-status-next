{
  "name": "@robot-inventor/baseline-status-next",
  "version": "1.0.1",
  "description": "A React component widget displaying Baseline status of a web feature in Next.js",
  "keywords": [
    "baseline",
    "next",
    "react"
  ],
  "homepage": "https://github.com/Robot-Inventor/baseline-status-next#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/baseline-status-next/issues"
  },
  "license": "Apache-2.0",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/baseline-status-next.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/BaselineStatus.js",
  "types": "./dist/BaselineStatus.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "oxlint ./src",
    "build": "tsc && shx cp \"./src/**/*.module.css\" \"./dist\"",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "ci:version": "changeset version",
    "ci:publish": "npm run build && changeset publish"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@robot-inventor/oxlint-config": "^1.2.0",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}
